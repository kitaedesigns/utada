+impl App {
+    /// utada-probe: once a second, append per-cell mpv counters to MVP_PROBE_PATH (CSV).
+    /// utada-probe: with MVP_PROBE_SWITCH set, step cell 0 to the next file in its folder
+    /// playlist (the app's own "next") 10 times and append the time until the new file
+    /// reports time-pos < 0.3 s and a frame has been rendered after that, to <probe>.switch.txt.
+    fn probe_switch(&mut self) {
+        if std::env::var_os("MVP_PROBE_SWITCH").is_none() || self.probe_sw_n >= 10 {
+            return;
+        }
+        let now = self.started.elapsed().as_secs_f64();
+        let Some(p) = self.runtime[0].player.clone() else { return };
+        match self.probe_sw {
+            None => {
+                if now > self.probe_sw_next.max(6.0) {
+                    self.next(0, 1);
+                    self.probe_sw = Some((Instant::now(), None));
+                }
+            }
+            Some((t0, seen)) => {
+                let (pos_ok, renders) = {
+                    let p = p.lock().unwrap();
+                    (p.loaded && p.number("time-pos").is_some_and(|x| x < 0.3), p.probe_renders)
+                };
+                let ms = t0.elapsed().as_secs_f64() * 1000.;
+                let done = match seen {
+                    None if pos_ok => { self.probe_sw = Some((t0, Some(renders))); false }
+                    Some(r) => renders > r,
+                    None => false,
+                };
+                if done || ms > 5000. {
+                    if let Some(path) = std::env::var_os("MVP_PROBE_PATH") {
+                        use std::io::Write;
+                        let path = format!("{}.switch.txt", path.to_string_lossy());
+                        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+                            let _ = writeln!(f, "{}", if done { format!("{ms:.0}") } else { "timeout".into() });
+                        }
+                    }
+                    self.probe_sw = None;
+                    self.probe_sw_n += 1;
+                    self.probe_sw_next = now + 2.0;
+                }
+            }
+        }
+    }
+    fn probe(&mut self) {
+        self.probe_paints += 1;
+        self.probe_switch();
+        // utada-probe: MVP_PROBE_REMOVE=1 removes cell 0 (the app's own "remove cell") at 20, 24, 28 s.
+        if std::env::var_os("MVP_PROBE_REMOVE").is_some() && self.probe_sw_n < 3 && self.remove_cell.is_none() {
+            let now = self.started.elapsed().as_secs_f64();
+            if now > 20. + 4. * self.probe_sw_n as f64 && self.state.cells.len() > 1 {
+                self.remove_cell = Some(0);
+                self.probe_sw_n += 1;
+            }
+        }
+        if self.probe_at.elapsed() < Duration::from_secs(1) {
+            return;
+        }
+        let Some(path) = std::env::var_os("MVP_PROBE_PATH") else { return };
+        use std::io::Write;
+        let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) else { return };
+        let t = self.started.elapsed().as_secs_f64();
+        let dt = self.probe_at.elapsed().as_secs_f64();
+        let _ = writeln!(f, "{t:.3},app,,,,,,,,,,{:.2}", self.probe_paints as f64 / dt);
+        for (i, r) in self.runtime.iter().enumerate().take(self.state.cells.len()) {
+            if let Some(p) = &r.player {
+                let p = p.lock().unwrap();
+                let n = |k: &str| p.number(k).map(|v| format!("{v}")).unwrap_or_default();
+                let file = self.state.cells[i].video.as_ref().map(|v| v.uri.rsplit(['/', '\\']).next().unwrap_or("").to_string()).unwrap_or_default();
+                let _ = writeln!(f, "{t:.3},{i},{file},{},{},{},{},{},{},{},{},",
+                    p.probe_strings.get("hwdec-current").cloned().unwrap_or_default(),
+                    n("time-pos"), n("container-fps"), n("estimated-vf-fps"),
+                    n("frame-drop-count"), n("decoder-frame-drop-count"), n("vo-delayed-frame-count"),
+                    p.probe_renders);
+            }
+        }
+        self.probe_at = Instant::now();
+        self.probe_paints = 0;
+    }
+}
